# 群聊被动参与插件配置（部署位置：<data_dir>/observer.toml，如 ~/.cc-connect/observer.toml）
# 总开关在 cc-connect 的 config.toml 顶层：observer = 本文件路径

# 每群滚动观察缓冲大小（条）
buffer_size = 50
# 激活时最多给模型看的最近消息条数
max_context_msgs = 30
# 激活后冷却秒数（避免连环激活）
cooldown_sec = 600
# 两次主动插话的最小间隔秒数
min_interval_sec = 900
# 主动插话每小时上限
max_per_hour = 3
# 提示词中标注的最近发言/触发记录条数
recent_replies_for_prompt = 10
# 回复率：只参与你认为属于前 X% 值得参与的话题（测试期可设 100）
reply_rate = 20
# 统一时间窗口（秒）：补转交过滤 / pending 超时即弃 / 真实回复后持续投递共用
window_sec = 600

# @ 或叫昵称（直接对话）的推理强度
at_effort = "medium"
# 主动插话回合的推理强度
proactive_effort = "low"
# 群聊回合一律隐藏思考/进度消息
suppress_group_progress = true
# 对外使用的名字（留空则用“本群机器人”）
persona_name = "小鲸鱼"
# 别称/昵称（人设中会说明；别人明确这样叫即视为直接对话）
persona_alias = "小鲸鱼"

# 补转交：补上次真实转交点到本次触发之间未转交的最近文本消息
catchup_max_msgs = 100
catchup_max_chars = 2000

# 激活规则列表：keyword（关键词命中）；multi_user（窗口内 ≥ min_users 人参与，bot 不计入）
[[rules]]
type = "keyword"
regex = ["什么", "怎么", "吗", "呢", "你们", "？"]

[[rules]]
type = "multi_user"
min_users = 4
window_sec = 300
